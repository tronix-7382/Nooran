generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SystemRole {
  ADMIN
  HELPER
  USER
}

enum OrganizationRole {
  OWNER
  ACCOUNTANT
}

enum PartyType {
  CUSTOMER
  SUPPLIER
}

enum InvoiceType {
  PURCHASE
  SALE
}

enum InvoiceStatus {
  DRAFT
  FINAL
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  OTHER
}

enum PaymentStatus {
  ACTIVE
  REVERSED
}

enum StockMovementType {
  PURCHASE_IN
  SALE_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  REVERSAL_IN
  REVERSAL_OUT
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model Organization {
  id      String  @id @default(uuid())
  name    String
  taxId   String? @unique
  phone   String
  address String?

  members  OrganizationMember[]
  parties  Party[]
  products Product[]
  batches  Batch[]
  invoices Invoice[]
  payments Payment[]
  stockMovements StockMovement[]
  journalEntries JournalEntry[]
  invoiceSequences InvoiceSequence[]
  accounts Account[]
  journalLines JournalLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id         String     @id @default(uuid())
  email      String     @unique
  password   String
  firstName  String
  lastName   String
  nationalId String?    @unique
  systemRole SystemRole @default(USER)
  isActive   Boolean    @default(true)
  phone      String?    @unique
  phoneVerifiedAt DateTime?

  memberships    OrganizationMember[]
  issuedInvoices Invoice[]
  refreshTokens RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  phoneVerificationCodes PhoneVerificationCode[]
  payments Payment[]
  stockMovements StockMovement[]
  journalEntries JournalEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrganizationMember {
  id             String           @id @default(uuid())
  userId         String
  organizationId String
  role           OrganizationRole @default(ACCOUNTANT)
  isActive       Boolean          @default(true)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
}

model Party {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  phone          String
  address        String?
  type           PartyType @default(CUSTOMER)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices     Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, phone])
  @@index([organizationId])
  @@unique([id, organizationId])
}

model Product {
  id               String  @id @default(uuid())
  organizationId   String
  name             String
  sku              String?
  unit             String
  salePriceDefault Decimal @db.Decimal(12, 2)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  batches      Batch[]
  invoiceItems InvoiceItem[]
  stockMovements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@unique([id, organizationId])
}

model Batch {
  id                String    @id @default(uuid())
  organizationId    String
  productId         String
  invoiceId         String
  purchasePrice     Decimal   @db.Decimal(12, 2)
  initialQuantity   Decimal   @db.Decimal(12, 3)
  remainingQuantity Decimal   @db.Decimal(12, 3)
  expireDate        DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId, organizationId], references: [id, organizationId])
  invoice      Invoice      @relation(fields: [invoiceId, organizationId], references: [id, organizationId])
  stockMovements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([productId])
  @@index([invoiceId])
  @@unique([id, organizationId, productId])
}

model Invoice {
  id              String        @id @default(uuid())
  organizationId  String
  partyId         String
  createdByUserId String
  invoiceNumber   String
  type            InvoiceType   @default(PURCHASE)
  totalAmount     Decimal       @default(0) @db.Decimal(14, 2)
  discountAmount Decimal @default(0) @db.Decimal(14, 2)
  taxAmount Decimal @default(0) @db.Decimal(14, 2)
  otherCharges Decimal @default(0) @db.Decimal(14, 2)
  currencyCode String @default("IRR") @db.VarChar(3)
  status          InvoiceStatus @default(DRAFT)

  organization Organization @relation(fields: [organizationId], references: [id])
  party        Party        @relation(fields: [partyId, organizationId], references: [id, organizationId])
  createdBy    User         @relation(fields: [createdByUserId], references: [id])

  batches Batch[]
  items   InvoiceItem[]
  payments Payment[]
  stockMovements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([partyId])
  @@index([createdByUserId])
  @@unique([id, organizationId])
}

model InvoiceItem {
  id             String  @id @default(uuid())
  organizationId String
  invoiceId      String
  productId      String
  quantity       Decimal @db.Decimal(12, 3)
  unitPrice      Decimal @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId, organizationId], references: [id, organizationId], onDelete: Cascade)
  product Product @relation(fields: [productId, organizationId], references: [id, organizationId])
  stockMovements StockMovement[]

  @@index([invoiceId, organizationId])
  @@index([productId, organizationId])
  @@unique([id, organizationId, invoiceId, productId])
}

model RefreshToken {
  id String @id @default(uuid())
  token String @unique
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createAt DateTime @default(now())
}

model PasswordResetToken {
  id String @id @default(uuid())
  tokenHash String @unique
  userId String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model PhoneVerificationCode {
  id String @id @default(uuid())
  userId String @unique
  phone String
  codeHash String
  attempts Int @default(0)
  expiresAt DateTime
  lastSentAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([phone])
  @@index([expiresAt])
}

model InvoiceSequence {
  id String @id @default(uuid())
  organizationId String
  year Int
  type InvoiceType
  nextNumber Int @default(1)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@unique([organizationId, year, type])
}

model Payment {
  id String @id @default(uuid())
  organizationId String
  invoiceId String
  createdByUserId String
  amount Decimal @db.Decimal(14, 2)
  method PaymentMethod
  reference String?
  status PaymentStatus @default(ACTIVE)
  reversedAt DateTime?
  reversalReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId, organizationId], references: [id, organizationId])
  createdBy User @relation(fields: [createdByUserId], references: [id])
  @@index([invoiceId, organizationId])
  @@index([createdByUserId])
}

model Account {
  id String @id @default(uuid())
  organizationId String
  code String
  name String
  type AccountType
  isSystem Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines JournalLine[]
  @@unique([organizationId, code])
  @@unique([id, organizationId])
}

model JournalEntry {
  id String @id @default(uuid())
  organizationId String
  sourceType String
  sourceId String
  description String
  currencyCode String @db.VarChar(3)
  transactionDate DateTime @default(now())
  createdByUserId String
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy User @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  lines JournalLine[]
  @@unique([organizationId, sourceType, sourceId])
  @@unique([id, organizationId])
  @@index([organizationId, transactionDate])
}

model JournalLine {
  id String @id @default(uuid())
  organizationId String
  journalEntryId String
  accountId String
  debit Decimal @default(0) @db.Decimal(14, 2)
  credit Decimal @default(0) @db.Decimal(14, 2)
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  entry JournalEntry @relation(fields: [journalEntryId, organizationId], references: [id, organizationId], onDelete: Restrict)
  account Account @relation(fields: [accountId, organizationId], references: [id, organizationId], onDelete: Restrict)
  @@index([organizationId, accountId, createdAt])
  @@index([journalEntryId, organizationId])
}

model StockMovement {
  id String @id @default(uuid())
  organizationId String
  productId String
  batchId String
  invoiceId String
  invoiceItemId String
  createdByUserId String
  type StockMovementType
  quantity Decimal @db.Decimal(12, 3)
  unitCost Decimal? @db.Decimal(12, 2)
  unitPrice Decimal? @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId, organizationId], references: [id, organizationId])
  batch Batch @relation(fields: [batchId, organizationId, productId], references: [id, organizationId, productId])
  invoice Invoice @relation(fields: [invoiceId, organizationId], references: [id, organizationId])
  invoiceItem InvoiceItem @relation(fields: [invoiceItemId, organizationId, invoiceId, productId], references: [id, organizationId, invoiceId, productId])
  createdBy User @relation(fields: [createdByUserId], references: [id])
  @@index([organizationId, productId, createdAt])
  @@index([batchId, createdAt])
  @@index([invoiceId, organizationId])
}
