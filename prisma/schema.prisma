generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SystemRole {
  ADMIN
  HELPER
  USER
}

enum OrganizationRole {
  OWNER
  ACCOUNTANT
}

enum PartyType {
  CUSTOMER
  SUPPLIER
}

enum InvoiceType {
  PURCHASE
  SALE
}

enum InvoiceStatus {
  DRAFT
  FINAL
  CANCELLED
}

model Organization {
  id      String  @id @default(uuid())
  name    String
  taxId   String? @unique
  phone   String
  address String?

  members  OrganizationMember[]
  parties  Party[]
  products Product[]
  batches  Batch[]
  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id         String     @id @default(uuid())
  email      String     @unique
  password   String
  firstName  String
  lastName   String
  nationalId String?    @unique
  systemRole SystemRole @default(USER)

  memberships    OrganizationMember[]
  issuedInvoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrganizationMember {
  id             String           @id @default(uuid())
  userId         String
  organizationId String
  role           OrganizationRole @default(ACCOUNTANT)
  isActive       Boolean          @default(true)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
}

model Party {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  phone          String
  address        String?
  type           PartyType @default(CUSTOMER)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices     Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, phone])
  @@index([organizationId])
}

model Product {
  id               String  @id @default(uuid())
  organizationId   String
  name             String
  sku              String?
  unit             String
  salePriceDefault Decimal @db.Decimal(12, 2)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  batches      Batch[]
  invoiceItems InvoiceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, sku])
  @@index([organizationId])
}

model Batch {
  id                String    @id @default(uuid())
  organizationId    String
  productId         String
  invoiceId         String
  purchasePrice     Decimal   @db.Decimal(12, 2)
  initialQuantity   Decimal   @db.Decimal(12, 3)
  remainingQuantity Decimal   @db.Decimal(12, 3)
  expireDate        DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id])
  invoice      Invoice      @relation(fields: [invoiceId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([productId])
  @@index([invoiceId])
}

model Invoice {
  id              String        @id @default(uuid())
  organizationId  String
  partyId         String
  createdByUserId String
  invoiceNumber   String
  type            InvoiceType   @default(PURCHASE)
  totalAmount     Decimal       @default(0) @db.Decimal(14, 2)
  status          InvoiceStatus @default(DRAFT)

  organization Organization @relation(fields: [organizationId], references: [id])
  party        Party        @relation(fields: [partyId], references: [id])
  createdBy    User         @relation(fields: [createdByUserId], references: [id])

  batches Batch[]
  items   InvoiceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([partyId])
  @@index([createdByUserId])
}

model InvoiceItem {
  id        String  @id @default(uuid())
  invoiceId String
  productId String
  quantity  Decimal @db.Decimal(12, 3)
  unitPrice Decimal @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@index([productId])
}
